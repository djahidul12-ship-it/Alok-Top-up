
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ALOK ADMIN</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#050b18;
 color:white;
 font-family:Arial,sans-serif;
}
header{
 background:#0b1730;
 padding:22px;
 text-align:center;
 border-bottom:2px solid #168cff;
}
h2{color:#168cff}
.container{padding:18px;max-width:650px;margin:auto}
.card{
 background:#101e36;
 border:1px solid #168cff;
 border-radius:12px;
 padding:18px;
 margin:15px 0;
}
input,button,select{
 width:100%;
 padding:13px;
 margin:8px 0;
 border-radius:8px;
 border:1px solid #168cff;
 font-size:15px;
}
input,select{background:#07152b;color:white}
button{
 background:#087cff;
 color:white;
 font-weight:bold;
 cursor:pointer;
}
button:hover{background:#005ac0}
.order{
 background:#07152b;
 padding:13px;
 margin:10px 0;
 border-radius:9px;
 border-left:3px solid #168cff;
}
small{color:#9bb8d8}
.hidden{display:none}
</style>
</head>
<body>

<header>
<h2>🔥 ALOK ADMIN</h2>
<small>TOP UP CONTROL PANEL</small>
</header>

<div class="container">

<div class="card" id="login">
<h3>🔐 Admin Login</h3>
<input type="password" id="pin" placeholder="Admin PIN">
<button onclick="loginAdmin()">LOGIN</button>
</div>

<div id="dashboard" class="hidden">

<div class="card">
<h3>📊 Dashboard</h3>
<p>মোট অর্ডার: <b id="total">0</b></p>
<p>Pending: <b id="pending">0</b></p>
<p>Completed: <b id="completed">0</b></p>
</div>

<div class="card">
<h3>📦 All Orders</h3>
<div id="orders">কোনো অর্ডার নেই।</div>
</div>

<button onclick="logout()">LOGOUT</button>
</div>
</div>

<script>
/*
DEMO ONLY:
বাস্তব ব্যবহারের আগে নিরাপদ Admin Authentication
এবং Firebase Database যুক্ত করতে হবে।
*/
const ADMIN_PIN="2468";

function loginAdmin(){
 if(document.getElementById("pin").value===ADMIN_PIN){
  document.getElementById("login").classList.add("hidden");
  document.getElementById("dashboard").classList.remove("hidden");
  showOrders();
 }else{
  alert("ভুল PIN!");
 }
}

function showOrders(){
 let orders=JSON.parse(localStorage.getItem("alokOrders")||"[]");
 document.getElementById("total").textContent=orders.length;
 document.getElementById("pending").textContent=
 orders.filter(o=>o.status==="Pending").length;
 document.getElementById("completed").textContent=
 orders.filter(o=>o.status==="Completed").length;

 document.getElementById("orders").innerHTML=
 orders.length ? orders.map((o,i)=>`
 <div class="order">
 <b>Order: ${escapeHTML(o.id)}</b><br>
 UID: ${escapeHTML(o.uid)}<br>
 Package: ${escapeHTML(o.package)}<br>
 Status: ${escapeHTML(o.status)}
 </div>`).join(""):"কোনো অর্ডার নেই।";
}

function escapeHTML(value){
 return String(value??"").replace(/[&<>"']/g,c=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",
 '"':"&quot;","'":"&#39;"
 }[c]));
}

function logout(){
 document.getElementById("dashboard").classList.add("hidden");
 document.getElementById("login").classList.remove("hidden");
 document.getElementById("pin").value="";
}

</script>
</body>
</html>
